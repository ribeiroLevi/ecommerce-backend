generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String  @db.VarChar(150)
  address  String  @db.VarChar(255)
  email    String  @unique @db.VarChar(255)
  login    String  @unique @db.VarChar(100)
  password String  @db.VarChar(255)
  adm      Boolean @default(false)
  sales    sales[]
}

model categories {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @unique @db.VarChar(100)
  description String     @db.VarChar(255)
  products    products[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String          @unique @db.VarChar(150)
  description   String          @db.VarChar(500)
  price         Decimal         @db.Decimal(10, 2)
  picture       String?         @db.VarChar(500)
  quantity      Int             @default(0)
  category_id   String          @db.Uuid
  categories    categories      @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_category")
  sale_products sale_products[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sale_products {
  sale_id    String   @db.Uuid
  product_id String   @db.Uuid
  price      Decimal  @db.Decimal(10, 2)
  quantity   Int
  products   products @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sale_product_product")
  sales      sales    @relation(fields: [sale_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sale_product_sale")

  @@id([sale_id, product_id])
}

model sales {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at    DateTime        @default(now()) @db.Timestamp(6)
  user_id       String          @db.Uuid
  sale_products sale_products[]
  users         users           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sale_user")
}
